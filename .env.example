# Copie os nomes abaixo para as env vars do Render (nao use este arquivo em producao,
# ele nunca deve conter valores reais nem ser commitado com segredos).

# Postgres (Supabase) - usar conexao Session/direta, nao o pooler em modo Transaction
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# JWT - gere um segredo forte e exclusivo de producao (minimo 32 bytes)
JWT_SECRET=

# Bootstrap do primeiro ADMIN
ADMIN_EMAIL=
ADMIN_SENHA=

# Geracao de questoes via IA (Groq, gratuito) - https://console.groq.com/keys
GROQ_API_KEY=

# Embeddings do RAG (OpenAI, paga por uso)
OPENAI_API_KEY=

# URL do frontend publicado (Vercel) - usada no CORS
FRONTEND_URL=https://<seu-app>.vercel.app

# Envio de codigo por email (confirmacao de cadastro/esqueci senha) - EmailJS (API REST),
# gratuito (200 emails/mes, sem cartao). Criar conta em emailjs.com, conectar um servico de
# email (ex.: Gmail via OAuth, sem precisar de senha de app), criar um template com as
# variaveis to_email/nome/assunto/instrucao/codigo, e habilitar "Allow EmailJS API for
# non-browser applications" em Account > Security (senao a Private Key e rejeitada).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
